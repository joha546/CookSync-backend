{
  "info": {
    "_postman_id": "cooksync-api-collection",
    "name": "CookSync API + Socket.IO",
    "description": "Full CookSync backend collection (REST + Socket.IO).\n\n## Setup\n1. Import `CookSync-Local.postman_environment.json`\n2. Set `baseUrl` (default `http://localhost:5000` — match your `.env` PORT)\n3. Set `adminEmail` to your `ADMIN_EMAIL` from `.env`\n4. Run **00 Stage 0 Gate** folder in order\n\n## Socket.IO in Postman\n1. New request → **Socket.IO** (not raw WebSocket)\n2. URL: `{{baseUrl}}`\n3. Header: `Authorization: Bearer {{jwt}}` (or chefJwt / adminJwt)\n4. Connect, then emit events listed in the **09 Socket.IO** folder\n5. Postman fallback: emit event `message` with body `{ \"event\": \"cooking-step\", \"data\": { \"recipeId\": \"...\", \"step\": \"...\" } }`\n\nSee `STAGE0_TO_STAGE1_GATE.md` for the readiness checklist.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "jwt", "value": "" },
    { "key": "chefJwt", "value": "" },
    { "key": "adminJwt", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "recipeId", "value": "" },
    { "key": "commentId", "value": "" },
    { "key": "otp", "value": "" }
  ],
  "item": [
    {
      "name": "00 Stage 0 Gate (run in order)",
      "description": "Run these sequentially after starting the server (`npm run dev`). All should pass before moving to Stage 1 hardening.",
      "item": [
        {
          "name": "G1 - Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API is running', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().message).to.eql('API is running.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "G2 - Send OTP (user)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/send-otp"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OTP sent', () => pm.response.to.have.status(200));",
                  "pm.test('Check your email and set {{otp}} in environment', () => true);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "G3 - Verify OTP (user) → saves jwt",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/verify-otp"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Login OK', () => pm.response.to.have.status(200));",
                  "if (res.token) {",
                  "  pm.environment.set('jwt', res.token);",
                  "  pm.collectionVariables.set('jwt', res.token);",
                  "  if (res.user && res.user._id) {",
                  "    pm.environment.set('userId', res.user._id);",
                  "    pm.collectionVariables.set('userId', res.user._id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "G4 - Add comment (correctness bug fix)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Stage 0 gate comment\"\n}"
            },
            "url": "{{baseUrl}}/api/recipes/{{recipeId}}/comment"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Comment added (not 500)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().message).to.eql('Comment added.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "G5 - Sort by likes (aggregation fix)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes?sortBy=likes&page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "recipes"],
              "query": [
                { "key": "sortBy", "value": "likes" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Recipes sorted endpoint works', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "G6 - Invalid JSON on create returns 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{chefJwt}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Bad Recipe", "type": "text" },
                { "key": "ingredients", "value": "not-valid-json", "type": "text" },
                { "key": "instructions", "value": "[\"step\"]", "type": "text" },
                { "key": "tags", "value": "[\"test\"]", "type": "text" },
                { "key": "nutrition", "value": "{\"calories\":100}", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/api/recipes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Validation error not 500', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error).to.include('ingredients');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
